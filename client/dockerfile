FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
ENV GENERATE_SOURCEMAP=false
RUN npm run build

FROM node:24-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder --chown=node:node /app/build ./build

USER node

EXPOSE 3000

CMD ["serve", "-s", "build", "-l", "3000"]
